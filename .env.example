# ==============================================================================
# KELVRIN SOVEREIGN AGENTIC AI WORKBENCH
# Environment Configuration Template (.env.example)
# Copy to .env and configure for your deployment. NEVER commit secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
KELVRIN_ENV=production
KELVRIN_HOST=0.0.0.0
KELVRIN_PORT=8000
FRONTEND_PORT=5173
JWT_SECRET_KEY=replace-with-a-cryptographically-random-32-byte-hex-string-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INITIAL_ADMIN_PASSWORD=replace-with-a-secure-admin-password-min-12-chars

# ------------------------------------------------------------------------------
# 2. Sovereignty & Authentication Architecture
# ------------------------------------------------------------------------------
# AUTH_MODE options:
#   local            - True Air-Gapped Enclave. Zero external network identity communication.
#                      Local argon2 / PBKDF2 offline password verification.
#   google_firebase  - Hybrid Sovereign Mode. External Google ID Token verification only.
#                      100% of documents, inference, and vector embeddings remain on-premises.
AUTH_MODE=local
KELVRIN_AUTH_MODE=airgap_local

# Firebase Configuration (Required ONLY if AUTH_MODE=google_firebase)
# Note: Zero Firestore or Cloud Storage used. Used solely for validating JWT identity tokens.
FIREBASE_PROJECT_ID=kelvrin-sovereign-workbench
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@kelvrin.iam.gserviceaccount.com
# Optional path to service account key file (if not using Google JWKS public certs):
FIREBASE_SERVICE_ACCOUNT_PATH=/workspace/secrets/firebase-service-account.json

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database & pgvector Storage
# ------------------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kelvrin_app
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_DB=kelvrin_db
DATABASE_URL=postgresql+asyncpg://kelvrin_app:replace-with-secure-postgres-password@postgres:5432/kelvrin_db

# ------------------------------------------------------------------------------
# 4. On-Premises Document Vault & Storage
# ------------------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=/workspace/data/sovereign_vault
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 Megabytes per document ceiling

# ------------------------------------------------------------------------------
# 5. Local AI Model Gateway (OpenAI-Compatible Local Endpoints)
# ------------------------------------------------------------------------------
# Point to local vLLM, Ollama, Triton, or LocalAI instances.
# Zero cloud AI endpoints (e.g. OpenAI, Anthropic, Gemini) are ever invoked.
LOCAL_INFERENCE_URL=http://local-model-service:11434/v1
LOCAL_EMBEDDING_URL=http://local-model-service:11434/v1
OLLAMA_BASE_URL=http://local-model-service:11434
VLLM_BASE_URL=http://local-model-service:8000/v1
LOCAL_AI_ONLY=true

# Sovereign Model Assignment
PRIMARY_LLM_MODEL=deepseek-r1:14b
FAST_ROUTER_MODEL=llama3.1:8b
VISION_MODEL=qwen2-vl:7b
EMBEDDING_MODEL=bge-m3
VECTOR_DIMENSIONS=1024

# ------------------------------------------------------------------------------
# 6. Isolated Python Code Sandbox Guardrails
# ------------------------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=5.0
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_NETWORK_DISABLED=true

# ------------------------------------------------------------------------------
# 7. Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AUTH_MODE=airgap_local
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderKeyForDevelopment
VITE_FIREBASE_AUTH_DOMAIN=kelvrin-sovereign-workbench.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kelvrin-sovereign-workbench
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
