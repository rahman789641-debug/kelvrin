# KELVRIN Sovereign Backend Environment Configuration
APP_NAME="KELVRIN Sovereign Agentic AI Workbench"
ENVIRONMENT="development"

# Security: Cryptographically secure JWT key (at least 32 characters)
JWT_SECRET_KEY="kelvrin-sovereign-development-master-jwt-key-2026-secure-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Password (at least 12 characters)
INITIAL_ADMIN_PASSWORD="KelvrinAdminSecurePassword2026!"

# Database: SQLite for local air-gap / development, or PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./kelvrin_sovereign.db"

# Auth Mode: local (Air-Gap Enclave) or firebase (Hybrid Google Enterprise)
AUTH_MODE="local"
KELVRIN_AUTH_MODE="AIR_GAP_LOCAL"
FIREBASE_PROJECT_ID="kelvrin-sovereign-ai"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
